---
import { ArrowRight, ChevronRight, Keyboard } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import VizEmbed from '../../components/VizEmbed.astro';
import data from '../../generated/course.json';

export function getStaticPaths() {
  return (data.visualizers as any[]).map((v) => ({ params: { id: v.id }, props: { v } }));
}

const { v } = Astro.props;
const base = import.meta.env.BASE_URL;
const labs = (data.labs as any[]).filter((l) => l.isPublic && v.labs.includes(l.n));
const all = data.visualizers as any[];
const i = all.findIndex((x) => x.id === v.id);
const next = all[(i + 1) % all.length];
---

<Layout title={v.title} description={v.summary}>
  <section class="container-page pt-8">
    <nav aria-label="Rruga" class="flex items-center gap-1.5 text-sm text-muted">
      <a href={`${base}vizualizime/`} class="hover:text-foreground">Vizualizimet</a>
      <ChevronRight className="size-3.5" />
      <span class="text-foreground">{v.title}</span>
    </nav>
    <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-3xl animate-fade-up">
        <p class="font-mono text-sm text-accent">{v.tagline}</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{v.title}</h1>
        <p class="mt-3 text-lg text-muted">{v.summary}</p>
      </div>
      <p class="hidden items-center gap-2 text-xs text-muted md:flex">
        <Keyboard className="size-4" /> ← → hapat · Hapësira luaj/ndalo · Home fillimi
      </p>
    </div>
  </section>

  <section class="container-page mt-8">
    <VizEmbed viz={v.id} />
  </section>

  <section class="container-page mt-12 grid grid-cols-1 gap-4 md:grid-cols-[1fr_auto]">
    <div class="rounded-3xl border border-border bg-surface p-6 shadow-surface">
      <h2 class="text-xs font-semibold tracking-wider text-muted uppercase">Përdoret në</h2>
      <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          labs.map((l) => (
            <li>
              <a href={`${base}laboratoret/${l.slug}/`} class="group flex items-center gap-3 rounded-2xl border border-border p-3 transition-colors hover:border-accent/40">
                <span class="font-mono text-xs font-bold text-accent">LAB {l.slug}</span>
                <span class="min-w-0 flex-1 truncate text-sm font-medium">{l.title}</span>
                <ArrowRight className="size-4 text-muted transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <a href={`${base}vizualizime/${next.id}/`} class="group card-hover flex flex-col justify-center rounded-3xl border border-border bg-surface p-6 shadow-surface md:w-72">
      <span class="text-xs text-muted">Vizualizimi tjetër</span>
      <span class="mt-1 flex items-center gap-2 font-semibold">{next.title} <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" /></span>
    </a>
  </section>
</Layout>
