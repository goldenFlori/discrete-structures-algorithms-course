---
import { ArrowRight } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/course.json';
import { VIZ_ICON } from '../../lib/icons';

const base = import.meta.env.BASE_URL;
const viz = data.visualizers as any[];
const labs = data.labs as any[];
---

<Layout title="Vizualizimet" description="Algoritmet e lëndës hap pas hapi, direkt në shfletues.">
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_80%_at_50%_0%,black,transparent)]"></div>
    <div class="container-page relative pt-14 pb-6">
      <p class="text-xs font-semibold tracking-wider text-accent uppercase">Interaktive · pa instalim</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Vizualizimet</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        {viz.length} vegla që i shohin algoritmet duke punuar — me pseudokodin e leksionit, me grafet e laboratorëve dhe me shpjegim për çdo hap.
      </p>
    </div>
  </section>

  <div class="container-page mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      viz.map((v) => {
        const Icon = VIZ_ICON[v.id];
        return (
          <a href={`${base}vizualizime/${v.id}/`} class="group card-hover flex flex-col rounded-3xl border border-border bg-surface p-6 shadow-surface">
            <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-brand to-brand-2 text-white shadow-md transition-transform duration-300 group-hover:scale-105 group-hover:rotate-[-4deg]">
              {Icon && <Icon className="size-6" />}
            </span>
            <h2 class="mt-5 text-lg font-semibold tracking-tight">{v.title}</h2>
            <p class="mt-1 font-mono text-xs text-accent">{v.tagline}</p>
            <p class="mt-3 text-sm text-muted">{v.summary}</p>
            <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
              {v.labs.map((n: number) => (
                <span class="chip chip--default chip--sm chip--secondary">
                  <span class="chip__label">Lab {n}</span>
                </span>
              ))}
              <ArrowRight className="ml-auto size-4 text-muted transition-transform group-hover:translate-x-1" />
            </div>
          </a>
        );
      })
    }
  </div>
</Layout>
