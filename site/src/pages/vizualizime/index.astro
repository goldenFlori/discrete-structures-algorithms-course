---
import Base from '../../layouts/Base.astro';
import data from '../../generated/course.json';

const base = import.meta.env.BASE_URL;
const viz = data.visualizers as any[];
const labs = data.labs as any[];
const labTitle = (n: number) => labs.find((l) => l.n === n)?.title ?? '';
---

<Base
  title="Vizualizime"
  description="Vizualizues interaktivë për algoritmet e lëndës — kompleksiteti, renditja, grafet, rrugët më të shkurtra dhe Floyd-Warshall."
>
  <div class="page">
    <header class="page-head">
      <h1>Vizualizime interaktive</h1>
      <p class="lede">
        Shumica e ushtrimeve në fletore hapin dritare Pygame ose Tkinter, që ekzekutohen vetëm
        në kompjuterin tuaj. Këto vegla bëjnë të njëjtën punë drejtpërdrejt në shfletues —
        të njëjtët algoritme, të njëjtat metrika, hap pas hapi.
      </p>
      <p class="muted" style="font-size:.9rem">
        Gjithçka ekzekutohet lokalisht në pajisjen tuaj. Asnjë e dhënë nuk dërgohet askund,
        nuk kërkohet llogari dhe asgjë nuk ruhet.
      </p>
    </header>

    <div class="viz-grid">
      {viz.map((v) => (
        <a class="card card-link vcard" href={`${base}vizualizime/${v.id}/`}>
          <div class="vcard-top">
            <span class="badge badge-accent">Interaktiv</span>
            {v.mobile === 'limited' && (
              <span class="badge badge-neutral" title="Funksionon në telefon, por me hapësirë të kufizuar">
                Më mirë në ekran të gjerë
              </span>
            )}
          </div>
          <h2>{v.title}</h2>
          <p class="vcard-tag mono">{v.tagline}</p>
          <p class="vcard-sum">{v.summary}</p>
          <div class="vcard-labs">
            {v.labs.map((n: number) => (
              <span class="chip" title={labTitle(n)}>Lab {String(n).padStart(2, '0')}</span>
            ))}
          </div>
          <span class="vcard-cta">Hape →</span>
        </a>
      ))}
    </div>

    <section class="note-block">
      <h2>Pse këto pesë dhe jo të tjera?</h2>
      <p>
        Secila u zgjodh sepse mbulon një koncept që shfaqet në disa laboratorë dhe që
        ndryshe do të humbiste plotësisht anën vizuale në shfletues:
      </p>
      <ul>
        <li><strong>Kompleksiteti</strong> zë dy laboratorë të plotë dhe dy detyra.</li>
        <li><strong>Renditja</strong> zëvendëson katër ushtrime Pygame të Laboratorëve 1–3.</li>
        <li><strong>Grafet</strong> zëvendëson pesë ushtrime Pygame/Tkinter të Laboratorëve 4–6.</li>
        <li><strong>Dijkstra kundrejt Bellman-Ford</strong> mbulon Laboratorin 7, i cili është tërësisht Pygame, dhe zë vendin e dy fletoreve plotësuese që varen nga një skript i papublikuar.</li>
        <li><strong>Floyd-Warshall</strong> është i vetmi algoritëm që shfaqet në dy laboratorë (7 dhe 8).</li>
      </ul>
      <p class="muted">
        Vizualizues për rrjedhat maksimale (Laboratorët 8 dhe 9) janë hapi i radhës;
        arkitektura është gati për ta pritur.
      </p>
    </section>
  </div>
</Base>

<style>
  .page { padding: 2rem 0 3rem; }
  .page-head { max-width: 720px; margin-bottom: 2rem; }
  .lede { color: var(--ink-2); font-size: 1.02rem; }

  .viz-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .vcard { display: flex; flex-direction: column; gap: .4rem; }
  .vcard-top { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .2rem; }
  .vcard h2 { margin: 0; font-size: 1.08rem; }
  .vcard-tag { font-size: .78rem; color: var(--accent); margin: 0; }
  .vcard-sum { font-size: .89rem; color: var(--ink-3); margin: .2rem 0 0; line-height: 1.55; }
  .vcard-labs { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .4rem; }
  .vcard-cta { margin-top: auto; padding-top: .6rem; font-size: .85rem; font-weight: 580; color: var(--accent); }

  .note-block {
    margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border);
    max-width: var(--measure);
  }
  .note-block h2 { font-size: 1.05rem; margin-top: 0; }
  .note-block li { margin: .4em 0; }
</style>
