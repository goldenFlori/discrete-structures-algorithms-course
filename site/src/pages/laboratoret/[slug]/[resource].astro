---
/** A supplementary notebook gets its own clean page, framed by its laboratory. */
import { ArrowLeft, ChevronRight, Download, ExternalLink } from 'lucide-react';
import Layout from '../../../layouts/Layout.astro';
import Notebook from '../../../components/nb/Notebook.astro';
import Toc from '../../../components/Toc.astro';
import data from '../../../generated/course.json';
import notebooks from '../../../generated/notebooks.json';

export function getStaticPaths() {
  const out: any[] = [];
  for (const lab of data.labs as any[]) {
    if (!lab.isPublic) continue;
    for (const r of lab.resources) {
      if (r.type === 'main' || !r.available) continue;
      out.push({ params: { slug: lab.slug, resource: r.notebook.replace(/\.ipynb$/, '') }, props: { lab, resource: r } });
    }
  }
  return out;
}

const { lab, resource } = Astro.props;
const base = import.meta.env.BASE_URL;
const { course } = data;
const nb = (notebooks as Record<string, any>)[resource.notebook];
const embeds = (data.embeds as Record<string, any[]>)[resource.notebook] ?? [];
const desktop = nb.flags.pygame || nb.flags.tkinter;
const colab = course.repo ? `https://colab.research.google.com/github/${course.repo}/blob/${course.branch || 'main'}/site/content/notebooks/${resource.notebook}` : null;
const title = resource.title.replace(/^Ushtrime Shtesë — /, '');
---

<Layout title={`${title} · Laboratori ${lab.n}`} description={resource.note || lab.summary}>
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_80%_at_20%_0%,black,transparent)]"></div>
    <div class="container-page relative pt-8">
      <nav aria-label="Rruga" class="flex items-center gap-1.5 text-sm text-muted">
        <a href={`${base}laboratoret/`} class="hover:text-foreground">Laboratorët</a>
        <ChevronRight className="size-3.5" />
        <a href={`${base}laboratoret/${lab.slug}/`} class="hover:text-foreground">Laboratori {lab.n}</a>
        <ChevronRight className="size-3.5" />
        <span class="text-foreground">Material plotësues</span>
      </nav>
      <div class="mt-6 max-w-3xl animate-fade-up">
        <div class="flex flex-wrap gap-2">
          <span class="chip chip--accent chip--sm chip--soft"><span class="chip__label">Material plotësues · Laboratori {lab.n}</span></span>
          {resource.lang === 'en' && <span class="chip chip--default chip--sm chip--secondary"><span class="chip__label">Në anglisht</span></span>}
        </div>
        <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">{title}</h1>
        {resource.note && <p class="mt-4 text-lg leading-relaxed text-muted">{resource.note}</p>}
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a href={`${base}shkarkime/${resource.notebook}`} download class="button button--primary gap-2"><Download className="size-4" /> Shkarko fletoren</a>
          {!desktop && colab && <a href={colab} target="_blank" rel="noopener noreferrer" class="button button--secondary gap-2"><ExternalLink className="size-4" /> Hap në Google Colab</a>}
          <a href={`${base}laboratoret/${lab.slug}/`} class="button button--tertiary gap-2"><ArrowLeft className="size-4" /> Laboratori {lab.n}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_14rem]">
    <article class="min-w-0">
      <Notebook notebook={nb} file={resource.notebook} embeds={embeds} />
    </article>
    <aside class="hidden lg:block"><Toc items={nb.toc} /></aside>
  </section>
</Layout>
