---
/** A supplementary notebook gets its own page, always framed by its laboratory. */
import Base from '../../../layouts/Base.astro';
import Notebook from '../../../components/Notebook.astro';
import LabToc from '../../../components/LabToc.astro';
import data from '../../../generated/course.json';
import notebooks from '../../../generated/notebooks.json';

export function getStaticPaths() {
  const out: any[] = [];
  for (const lab of data.labs as any[]) {
    if (!lab.isPublic) continue;
    for (const r of lab.resources) {
      if (r.type === 'main' || !r.available) continue;
      out.push({
        params: { slug: lab.slug, resource: r.notebook.replace(/\.ipynb$/, '') },
        props: { lab, resource: r },
      });
    }
  }
  return out;
}

const { lab, resource } = Astro.props;
const base = import.meta.env.BASE_URL;
const nb = (notebooks as Record<string, any>)[resource.notebook];
const kb = (n: number) => (n > 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.round(n / 1024)} KB`);

// Sibling supplementary resources in the same lab, for lateral navigation.
const siblings = lab.resources.filter(
  (r: any) => r.type !== 'main' && r.available && r.notebook !== resource.notebook,
);
---

<Base title={`${resource.title} — Laboratori ${lab.slug}`} description={resource.note}>
  <article class="res">
    <header class="res-header">
      <nav class="crumbs no-print" aria-label="Rruga">
        <a href={`${base}laboratoret/`}>Laboratorët</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}laboratoret/${lab.slug}/`}>Laboratori {lab.slug}</a>
        <span aria-hidden="true">/</span>
        <span>Material plotësues</span>
      </nav>

      <div class="res-eyebrow">
        <span class="badge badge-violet">Material plotësues</span>
        {resource.lang === 'en' && <span class="badge badge-neutral">Përmbajtja në anglisht</span>}
        <a class="res-parent" href={`${base}laboratoret/${lab.slug}/`}>
          Pjesë e Laboratorit {lab.slug} — {lab.title}
        </a>
      </div>

      <h1>{resource.title}</h1>
      {resource.note && <p class="res-lede">{resource.note}</p>}

      <p class="res-meta">
        <code>{resource.notebook}</code>
        <span>·</span><span>{nb.stats.code} qeliza kodi</span>
        <span>·</span><span>{kb(nb.sizeBytes)}</span>
      </p>

      <div class="res-actions no-print">
        <a class="btn btn-sm" href={`${base}shkarkime/${resource.notebook}`} download>Shkarko fletoren</a>
        <a class="btn btn-sm" href={`${base}laboratoret/${lab.slug}/`}>← Kthehu te laboratori</a>
      </div>

      {nb.missingScripts.length > 0 && (
        <div class="callout callout-warn">
          <p class="callout-title">Një pjesë e kësaj fletoreje nuk funksionon ashtu siç është</p>
          <p>
            Fletorja nis skriptet
            {nb.missingScripts.map((s: string, i: number) => (<>{i > 0 && ', '}<code>{s}</code></>))},
            të cilat nuk janë pjesë e materialeve të publikuara. Seksioni i ecjes hap-pas-hapi
            nuk do të hapet pa to.
          </p>
          <p style="margin-bottom:0">
            Teoria, kodi i algoritmit dhe ushtrimet janë të plota dhe funksionojnë.
            Për ecjen hap-pas-hapi në shfletues, përdorni
            <a href={`${base}vizualizime/rruget/`}>vizualizuesin Dijkstra kundrejt Bellman-Ford</a>.
          </p>
        </div>
      )}

      {nb.flags.widgets && (
        <div class="callout callout-info">
          <p class="callout-title">Kontrolle interaktive të Jupyter-it</p>
          <p style="margin:0">
            Kjo fletore përdor <code>ipywidgets</code>. Butonat funksionojnë vetëm me një kernel
            Jupyter aktiv — shkarkojeni dhe ekzekutojeni lokalisht.
          </p>
        </div>
      )}
    </header>

    <div class="res-body">
      <aside class="res-side no-print"><LabToc toc={nb.toc} title="Në këtë material" /></aside>
      <div class="res-main"><Notebook notebook={nb} /></div>
    </div>

    {siblings.length > 0 && (
      <section class="siblings no-print">
        <h2 class="section-rule">Materiale të tjera të këtij laboratori</h2>
        <div class="grid grid-2">
          {siblings.map((s: any) => (
            <a class="card card-link" href={`${base}laboratoret/${lab.slug}/${s.notebook.replace(/\.ipynb$/, '')}/`}>
              <strong>{s.title}</strong>
              {s.note && <p class="muted" style="margin:.3rem 0 0;font-size:.87rem">{s.note}</p>}
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="res-back no-print">
      <a class="card card-link" href={`${base}laboratoret/${lab.slug}/`}>
        <small>← Kthehu te</small>
        <strong>Laboratori {lab.slug} — {lab.title}</strong>
      </a>
    </nav>
  </article>
</Base>

<style>
  .res { padding: 1.5rem 0 3rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .84rem; color: var(--ink-faint); margin-bottom: 1rem; }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }

  .res-header { max-width: 820px; }
  .res-eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-bottom: .7rem; }
  .res-parent { font-size: .84rem; color: var(--ink-3); text-decoration: none; }
  .res-parent:hover { color: var(--accent); }
  .res-lede { font-size: 1.02rem; color: var(--ink-2); }
  .res-meta { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .82rem; color: var(--ink-faint); }
  .res-meta code { font-size: .78rem; }
  .res-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0 1.5rem; }

  .res-body { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem; }
  @media (min-width: 1025px) {
    .res-body { grid-template-columns: 230px minmax(0, 1fr); gap: 3rem; align-items: start; }
    .res-side { order: -1; }
  }
  .res-main { min-width: 0; }

  .section-rule {
    font-size: .76rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3);
    padding-bottom: .5rem; border-bottom: 1px solid var(--border); margin: 3rem 0 1.2rem;
  }
  .siblings { margin-top: 3rem; }
  .res-back { margin-top: 2.5rem; max-width: 480px; }
  .res-back a { display: flex; flex-direction: column; gap: .2rem; }
  .res-back small { color: var(--ink-3); font-size: .8rem; }
</style>
