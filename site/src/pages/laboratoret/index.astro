---
import Layout from '../../layouts/Layout.astro';
import LabCard from '../../components/LabCard.astro';
import data from '../../generated/course.json';
import { BLOCK_COLOR, BLOCK_ICON } from '../../lib/icons';

const labs = (data.labs as any[]).filter((l) => l.isPublic);
const blocks = data.blocks as any[];
const comingSoon = (data.labs as any[]).filter((l) => l.status === 'coming-soon');
---

<Layout title="Laboratorët" description="Të gjithë laboratorët e lëndës, sipas blloqeve tematike.">
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_80%_at_50%_0%,black,transparent)]"></div>
    <div class="container-page relative pt-14 pb-6">
      <p class="text-xs font-semibold tracking-wider text-accent uppercase">Programi i laboratorit</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Laboratorët</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        {labs.length} laboratorë, të renditur sipas leksioneve. Çdo laborator ka teorinë, ushtrimet dhe vizualizimet e veta interaktive.
      </p>
    </div>
  </section>

  <div class="container-page mt-8 flex flex-col gap-14">
    {
      blocks.map((b, i) => {
        const Icon = BLOCK_ICON[b.id];
        const list = labs.filter((l) => b.labs.includes(l.n));
        if (!list.length) return null;
        return (
          <section>
            <div class="flex flex-wrap items-center gap-3">
              <span class="grid size-10 place-items-center rounded-2xl text-white" style={`background: ${BLOCK_COLOR[b.id]}`}>
                {Icon && <Icon className="size-5" />}
              </span>
              <div>
                <p class="font-mono text-[0.7rem] font-semibold text-muted">BLLOKU {i + 1}</p>
                <h2 class="text-xl font-bold tracking-tight">{b.name}</h2>
              </div>
              {b.lectures && (
                <span class="chip chip--default chip--sm chip--secondary ml-1">
                  <span class="chip__label">{b.lectures}</span>
                </span>
              )}
            </div>
            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {list.map((l) => (
                <LabCard lab={l} block={b.id} />
              ))}
            </div>
          </section>
        );
      })
    }
    {
      comingSoon.length > 0 && (
        <section class="rounded-3xl border border-dashed border-border p-6 text-center text-muted">
          Së shpejti: {comingSoon.map((l) => `Laboratori ${l.n}`).join(', ')}.
        </section>
      )
    }
  </div>
</Layout>
