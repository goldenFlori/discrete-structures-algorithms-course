---
import { ArrowLeft, ArrowRight, BookMarked, ChevronRight, ClipboardList, Download, ExternalLink, FileText, Sparkles } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import Notebook from '../../components/nb/Notebook.astro';
import Toc from '../../components/Toc.astro';
import data from '../../generated/course.json';
import notebooks from '../../generated/notebooks.json';
import { BLOCK_COLOR, VIZ_ICON } from '../../lib/icons';

export function getStaticPaths() {
  // Draft and coming-soon laboratories never get a page.
  return (data.labs as any[]).filter((l) => l.isPublic).map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}

const { lab } = Astro.props;
const base = import.meta.env.BASE_URL;
const nbs: Record<string, any> = notebooks;
const { course } = data;
const embeds = data.embeds as Record<string, any[]>;
const block = (data.blocks as any[]).find((b) => b.labs.includes(lab.n));
const color = BLOCK_COLOR[block?.id] ?? 'var(--brand)';
const topicName = (id: string) => (data.topics as any[]).find((t) => t.id === id)?.name || id;
const vizMeta = (id: string) => (data.visualizers as any[]).find((v) => v.id === id);

const pub = (data.labs as any[]).filter((l) => l.isPublic);
const idx = pub.findIndex((l) => l.n === lab.n);
const prev = idx > 0 ? pub[idx - 1] : null;
const next = idx < pub.length - 1 ? pub[idx + 1] : null;

const main = lab.resources.filter((r: any) => r.type === 'main' && r.available);
const supp = lab.resources.filter((r: any) => r.type !== 'main' && r.available);
const primary = main[0];
const primaryNb = primary ? nbs[primary.notebook] : null;

const toc = (() => {
  if (!primaryNb) return [];
  if (!primary.slice?.length) return primaryNb.toc;
  const ids = new Set(
    primary.slice
      .flatMap((r: any) => primaryNb.cells.slice(r.from ?? 0, r.to ?? primaryNb.cells.length))
      .filter((c: any) => c.type === 'markdown' && c.id)
      .map((c: any) => c.id),
  );
  return primaryNb.toc.filter((t: any) => ids.has(t.id));
})();

const mainViz = (lab.viz as any[]).filter((v) => v.type === 'main');
const exercises = toc.filter((t: any) => t.kind === 'exercise').length;
const hasClasswork = toc.some((t: any) => t.kind === 'classwork');
const hwStandalone = (data.homework as any[]).filter((h) => h.lab === lab.n || (h.alsoLabs || []).includes(lab.n));
const desktop = lab.flags.pygame || lab.flags.tkinter;
const colab = (file: string) => (course.repo ? `https://colab.research.google.com/github/${course.repo}/blob/${course.branch || 'main'}/site/content/notebooks/${file}` : null);
const notebookFlags = (file: string) => nbs[file]?.flags ?? {};
---

<Layout title={`Laboratori ${lab.n} — ${lab.title}`} description={lab.summary}>
  <div class="relative">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] opacity-70" style={`background: radial-gradient(60% 80% at 15% 0%, color-mix(in oklab, ${color} 22%, transparent), transparent 70%)`}></div>

    <!-- ========================================================== HEADER -->
    <section class="container-page relative pt-8 pb-4">
      <nav aria-label="Rruga" class="flex items-center gap-1.5 text-sm text-muted">
        <a href={`${base}laboratoret/`} class="hover:text-foreground">Laboratorët</a>
        <ChevronRight className="size-3.5" />
        <span class="text-foreground">Laboratori {lab.n}</span>
      </nav>

      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
        <div class="animate-fade-up">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full px-3 py-1 font-mono text-xs font-bold tracking-wider text-white" style={`background: ${color}`}>LAB {lab.slug}</span>
            {lab.week && <span class="chip chip--default chip--sm chip--secondary"><span class="chip__label">Java {lab.week}</span></span>}
            {lab.lecture && (
              <span class="chip chip--accent chip--sm chip--soft">
                <span class="chip__label">{lab.lecture}</span>
              </span>
            )}
          </div>
          <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-[2.6rem]">{lab.title}</h1>
          {lab.summary && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{lab.summary}</p>}
          {
            lab.topics?.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {lab.topics.map((t: string) => (
                  <span class="chip chip--default chip--sm chip--secondary">
                    <span class="chip__label">{topicName(t)}</span>
                  </span>
                ))}
              </div>
            )
          }
          <div class="mt-7 flex flex-wrap gap-2.5">
            {
              primary && (
                <a href={`${base}shkarkime/${primary.notebook}`} download class="button button--primary gap-2">
                  <Download className="size-4" /> Shkarko fletoren
                </a>
              )
            }
            {
              primary && !desktop && colab(primary.notebook) && (
                <a href={colab(primary.notebook)} target="_blank" rel="noopener noreferrer" class="button button--secondary gap-2">
                  <ExternalLink className="size-4" /> Hap në Google Colab
                </a>
              )
            }
            {
              course.classroomUrl && (
                <a href={course.classroomUrl} target="_blank" rel="noopener noreferrer" class="button button--secondary gap-2">
                  <ExternalLink className="size-4" /> Classroom
                </a>
              )
            }
            {
              mainViz.length > 0 && (
                <a href={`#${mainViz[0].anchor}`} class="button button--tertiary gap-2">
                  <Sparkles className="size-4" /> Te vizualizimi i parë
                </a>
              )
            }
          </div>
        </div>

        <aside class="animate-fade-up rounded-3xl border border-border bg-surface/90 p-5 shadow-surface backdrop-blur [animation-delay:100ms]" aria-label="Në këtë laborator">
          <h2 class="text-xs font-semibold tracking-wider text-muted uppercase">Në këtë laborator</h2>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-2xl bg-surface-secondary px-2 py-2.5">
              <dd class="font-mono text-xl font-bold">{mainViz.length}</dd>
              <dt class="text-[0.7rem] text-muted">vizualizime</dt>
            </div>
            <div class="rounded-2xl bg-surface-secondary px-2 py-2.5">
              <dd class="font-mono text-xl font-bold">{exercises}</dd>
              <dt class="text-[0.7rem] text-muted">ushtrime</dt>
            </div>
            <div class="rounded-2xl bg-surface-secondary px-2 py-2.5">
              <dd class="font-mono text-xl font-bold">{supp.length}</dd>
              <dt class="text-[0.7rem] text-muted">plotësuese</dt>
            </div>
          </dl>
          {
            mainViz.length > 0 && (
              <ul class="mt-4 space-y-1">
                {mainViz.map((v) => {
                  const Icon = VIZ_ICON[v.viz];
                  return (
                    <li>
                      <a href={`#${v.anchor}`} class="group flex items-center gap-3 rounded-xl px-2 py-1.5 transition-colors hover:bg-default">
                        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-brand to-brand-2 text-white">{Icon && <Icon className="size-4" />}</span>
                        <span class="min-w-0 flex-1 truncate text-sm font-medium">{v.title ?? vizMeta(v.viz)?.title}</span>
                        <ArrowRight className="size-3.5 text-muted opacity-0 transition-opacity group-hover:opacity-100" />
                      </a>
                    </li>
                  );
                })}
              </ul>
            )
          }
          {
            (hasClasswork || lab.homeworkEmbedded.length > 0 || hwStandalone.length > 0) && (
              <div class="mt-4 flex flex-wrap gap-1.5 border-t border-separator pt-4">
                {hasClasswork && <span class="chip chip--warning chip--sm chip--soft"><span class="chip__label">Punë në klasë</span></span>}
                {(lab.homeworkEmbedded.length > 0 || hwStandalone.length > 0) && (
                  <a href="#detyrat" class="chip chip--danger chip--sm chip--soft"><span class="chip__label">Detyrë shtëpie</span></a>
                )}
              </div>
            )
          }
        </aside>
      </div>
    </section>

    <!-- ========================================================= CONTENT -->
    <section class="container-page relative mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <article class="min-w-0">
        {
          main.map((r: any) =>
            nbs[r.notebook] ? (
              <Notebook notebook={nbs[r.notebook]} file={r.notebook} slice={r.slice} embeds={embeds[r.notebook] ?? []} />
            ) : null,
          )
        }

        {
          supp.length > 0 && (
            <section id="material-plotesues" class="mt-16 scroll-mt-24">
              <h2 class="text-2xl font-bold tracking-tight">Material plotësues</h2>
              <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {supp.map((r: any) => {
                  const flags = notebookFlags(r.notebook);
                  const nViz = (lab.viz as any[]).filter((v) => v.resource === r.notebook).length;
                  return (
                    <a href={`${base}laboratoret/${lab.slug}/${r.notebook.replace(/\.ipynb$/, '')}/`} class="group card-hover flex flex-col rounded-3xl border border-border bg-surface p-5 shadow-surface">
                      <div class="flex items-center gap-2 text-xs text-muted">
                        <BookMarked className="size-4 text-accent" />
                        {r.lang === 'en' ? 'Material plotësues · në anglisht' : 'Material plotësues'}
                      </div>
                      <h3 class="mt-2 font-semibold tracking-tight">{r.title}</h3>
                      {r.note && <p class="mt-1.5 line-clamp-3 text-sm text-muted">{r.note}</p>}
                      <div class="mt-auto flex items-center gap-2 pt-4 text-xs text-muted">
                        {nViz > 0 && <span class="chip chip--accent chip--sm chip--soft"><span class="chip__label">{nViz} vizualizime</span></span>}
                        {!flags.pygame && !flags.tkinter && <span class="chip chip--success chip--sm chip--soft"><span class="chip__label">punon në Colab</span></span>}
                        <ArrowRight className="ml-auto size-4 transition-transform group-hover:translate-x-1" />
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          )
        }

        {
          (lab.homeworkEmbedded.length > 0 || hwStandalone.length > 0) && (
            <section id="detyrat" class="mt-16 scroll-mt-24">
              <h2 class="text-2xl font-bold tracking-tight">Detyra e shtëpisë</h2>
              <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {lab.homeworkEmbedded.map((h: any) => (
                  <a href={`#${h.anchor}`} class="group card-hover flex flex-col rounded-3xl border border-border bg-surface p-5 shadow-surface">
                    <div class="flex items-center gap-2 text-xs text-muted">
                      <ClipboardList className="size-4 text-danger" /> Brenda fletores së laboratorit
                    </div>
                    <h3 class="mt-2 font-semibold tracking-tight">{h.title}</h3>
                    {h.note && <p class="mt-1.5 text-sm text-muted">{h.note.replace(/`/g, '')}</p>}
                  </a>
                ))}
                {hwStandalone.map((h: any) => (
                  <a href={`${base}detyrat/${h.id}/`} class="group card-hover flex flex-col rounded-3xl border border-border bg-surface p-5 shadow-surface">
                    <div class="flex items-center gap-2 text-xs text-muted">
                      <FileText className="size-4 text-danger" /> Fletore më vete
                    </div>
                    <h3 class="mt-2 font-semibold tracking-tight">{h.title}</h3>
                    <ArrowRight className="mt-auto ml-auto size-4 text-muted transition-transform group-hover:translate-x-1" />
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <!-- prev / next -->
        <nav class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Laboratorët e tjerë">
          {
            prev ? (
              <a href={`${base}laboratoret/${prev.slug}/`} class="group card-hover rounded-3xl border border-border bg-surface p-5 shadow-surface">
                <span class="flex items-center gap-1.5 text-xs text-muted">
                  <ArrowLeft className="size-3.5 transition-transform group-hover:-translate-x-1" /> Laboratori {prev.n}
                </span>
                <span class="mt-1.5 block font-semibold tracking-tight">{prev.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`${base}laboratoret/${next.slug}/`} class="group card-hover rounded-3xl border border-border bg-surface p-5 text-right shadow-surface">
                <span class="flex items-center justify-end gap-1.5 text-xs text-muted">
                  Laboratori {next.n} <ArrowRight className="size-3.5 transition-transform group-hover:translate-x-1" />
                </span>
                <span class="mt-1.5 block font-semibold tracking-tight">{next.title}</span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="hidden lg:block">
        <Toc items={toc} extra={[...(supp.length ? [{ id: 'material-plotesues', title: 'Material plotësues' }] : []), ...(lab.homeworkEmbedded.length || hwStandalone.length ? [{ id: 'detyrat', title: 'Detyra e shtëpisë' }] : [])]} />
      </aside>
    </section>
  </div>
</Layout>
