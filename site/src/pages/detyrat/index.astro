---
import { ArrowRight, ClipboardList, FileText } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/course.json';

const base = import.meta.env.BASE_URL;
const labs = (data.labs as any[]).filter((l) => l.isPublic);
const standalone = (data.homework as any[]).filter((h) => (h.status ?? 'published') !== 'draft');
const embedded = labs.flatMap((l) => (l.homeworkEmbedded || []).map((h: any) => ({ ...h, lab: l })));

// one list, in the order of the course
const items = [
  ...standalone.map((h) => ({ kind: 'file', lab: h.lab, title: h.title, text: h.summary, href: `${base}detyrat/${h.id}/` })),
  ...embedded.map((h) => ({ kind: 'embedded', lab: h.lab.n, title: h.title, text: h.note, href: `${base}laboratoret/${h.lab.slug}/#${h.anchor}` })),
].sort((a, b) => a.lab - b.lab);
---

<Layout title="Detyrat e shtëpisë" description="Të gjitha detyrat e shtëpisë së semestrit në një listë.">
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_80%_at_50%_0%,black,transparent)]"></div>
    <div class="container-page relative pt-14 pb-6">
      <p class="text-xs font-semibold tracking-wider text-danger uppercase">Pas laboratorit</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Detyrat e shtëpisë</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">Të gjitha detyrat e semestrit, sipas laboratorit ku jepen.</p>
    </div>
  </section>

  <div class="container-page mt-8">
    <ol class="relative grid gap-4 border-l border-separator pl-6 sm:pl-8">
      {
        items.map((h) => (
          <li class="relative">
            <span class="absolute top-6 -left-[1.95rem] grid size-4 place-items-center rounded-full border-2 border-danger bg-background sm:-left-[2.45rem]" />
            <a href={h.href} class="group card-hover flex flex-col gap-2 rounded-3xl border border-border bg-surface p-5 shadow-surface sm:flex-row sm:items-center sm:gap-5">
              <span class="font-mono text-xs font-bold text-danger">LAB {String(h.lab).padStart(2, '0')}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold tracking-tight">{h.title}</span>
                {h.text && <span class="mt-1 line-clamp-2 block text-sm text-muted">{String(h.text).replace(/`/g, '')}</span>}
              </span>
              <span class="flex items-center gap-2 text-xs text-muted">
                {h.kind === 'file' ? <FileText className="size-4" /> : <ClipboardList className="size-4" />}
                {h.kind === 'file' ? 'Fletore më vete' : 'Brenda laboratorit'}
                <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Layout>
