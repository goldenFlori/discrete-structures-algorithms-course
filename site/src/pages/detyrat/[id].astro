---
import { ArrowLeft, ChevronRight, Download, ExternalLink } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import Notebook from '../../components/nb/Notebook.astro';
import Toc from '../../components/Toc.astro';
import data from '../../generated/course.json';
import notebooks from '../../generated/notebooks.json';

export function getStaticPaths() {
  return (data.homework as any[]).filter((h) => (h.status ?? 'published') !== 'draft').map((h) => ({ params: { id: h.id }, props: { hw: h } }));
}

const { hw } = Astro.props;
const base = import.meta.env.BASE_URL;
const { course } = data;
const nb = hw.notebook ? (notebooks as Record<string, any>)[hw.notebook] : null;
const labs = data.labs as any[];
const lab = labs.find((l) => l.n === hw.lab);
const topicName = (id: string) => (data.topics as any[]).find((t) => t.id === id)?.name || id;
const colab = course.repo && hw.notebook ? `https://colab.research.google.com/github/${course.repo}/blob/${course.branch || 'main'}/site/content/notebooks/${hw.notebook}` : null;
const desktop = nb && (nb.flags.pygame || nb.flags.tkinter);
---

<Layout title={`Detyrë — ${hw.title}`} description={hw.summary}>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[360px] opacity-70" style="background: radial-gradient(60% 80% at 15% 0%, color-mix(in oklab, var(--danger) 16%, transparent), transparent 70%)"></div>
    <div class="container-page relative pt-8">
      <nav aria-label="Rruga" class="flex items-center gap-1.5 text-sm text-muted">
        <a href={`${base}detyrat/`} class="hover:text-foreground">Detyrat</a>
        <ChevronRight className="size-3.5" />
        <span class="text-foreground">{hw.title}</span>
      </nav>
      <div class="mt-6 max-w-3xl animate-fade-up">
        <div class="flex flex-wrap gap-2">
          <span class="chip chip--danger chip--sm chip--soft"><span class="chip__label">Detyrë shtëpie</span></span>
          {lab && <span class="chip chip--default chip--sm chip--secondary"><span class="chip__label">Laboratori {lab.n}</span></span>}
          {(hw.topics ?? []).map((t: string) => <span class="chip chip--default chip--sm chip--tertiary"><span class="chip__label">{topicName(t)}</span></span>)}
          {hw.due && <span class="chip chip--warning chip--sm chip--soft"><span class="chip__label">Afati: {hw.due}</span></span>}
        </div>
        <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">{hw.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{hw.summary?.replace(/`/g, '')}</p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {hw.notebook && <a href={`${base}shkarkime/${hw.notebook}`} download class="button button--primary gap-2"><Download className="size-4" /> Shkarko fletoren</a>}
          {colab && !desktop && <a href={colab} target="_blank" rel="noopener noreferrer" class="button button--secondary gap-2"><ExternalLink className="size-4" /> Hap në Google Colab</a>}
          {lab && <a href={`${base}laboratoret/${lab.slug}/`} class="button button--tertiary gap-2"><ArrowLeft className="size-4" /> Laboratori {lab.n}</a>}
        </div>
      </div>
    </div>
  </section>

  {
    nb && (
      <section class="container-page mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_14rem]">
        <article class="min-w-0">
          <Notebook notebook={nb} file={hw.notebook} spoilerWarning={hw.spoilerWarning} />
        </article>
        <aside class="hidden lg:block">
          <Toc items={nb.toc} />
        </aside>
      </section>
    )
  }
</Layout>
