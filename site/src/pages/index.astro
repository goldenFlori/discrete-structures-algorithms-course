---
import { ArrowRight, BookOpenCheck, Download, MousePointerClick, Play, Sparkles } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import LabCard from '../components/LabCard.astro';
import HeroVisual from '../components/HeroVisual.astro';
import data from '../generated/course.json';
import { BLOCK_COLOR, BLOCK_ICON, VIZ_ICON } from '../lib/icons';

const base = import.meta.env.BASE_URL;
const { course } = data;
const labs = (data.labs as any[]).filter((l) => l.isPublic);
const latest = labs.find((l) => l.n === data.latestLab) ?? labs[labs.length - 1];
const blocks = data.blocks as any[];
const viz = data.visualizers as any[];
const blockOf = (n: number) => blocks.find((b) => b.labs.includes(n))?.id ?? 'renditja';
const embedCount = labs.reduce((s, l) => s + l.viz.length, 0);
const latestViz = (latest?.viz ?? []) as any[];
const vizMeta = (id: string) => viz.find((v) => v.id === id);
---

<Layout title={course.title}>
  <!-- ============================================================ HERO -->
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_75%_65%_at_50%_0%,black,transparent)]"></div>
    <div
      class="pointer-events-none absolute -top-48 left-1/2 h-[620px] w-[1200px] -translate-x-1/2"
      style="background: radial-gradient(closest-side at 35% 50%, var(--glow-1), transparent), radial-gradient(closest-side at 70% 45%, var(--glow-2), transparent)"
    >
    </div>

    <div class="container-page relative grid grid-cols-1 items-center gap-12 pt-14 pb-16 lg:grid-cols-[1.05fr_1fr] lg:pt-20 lg:pb-24">
      <div class="animate-fade-up">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-3 py-1 text-xs font-medium text-muted backdrop-blur">
          <span class="size-1.5 rounded-full bg-success"></span>
          {course.year} · {course.program}
        </span>
        <h1 class="mt-5 text-[2.6rem] leading-[1.04] font-extrabold tracking-tight text-balance sm:text-6xl">
          Struktura Diskrete <span class="text-gradient">&amp; Algoritme</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          Laboratorët e lëndës në një vend: teoria, ushtrimet dhe <strong class="font-semibold text-foreground">{viz.length} vizualizime interaktive</strong> që
          punojnë direkt në shfletues — nga renditja dhe Big-O te grafet, rrugët më të shkurtra dhe rrjedhat maksimale.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {
            latest && (
              <a href={`${base}laboratoret/${latest.slug}/`} class="button button--lg button--primary gap-2">
                <Play className="size-4" /> Laboratori {latest.n}
              </a>
            )
          }
          <a href={`${base}laboratoret/`} class="button button--lg button--secondary gap-2">
            Të gjithë laboratorët <ArrowRight className="size-4" />
          </a>
        </div>
        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-3">
          {
            [
              [labs.length, 'laboratorë'],
              [viz.length, 'vizualizime'],
              [embedCount, 'ushtrime interaktive'],
            ].map(([n, l]) => (
              <div class="rounded-2xl border border-border bg-surface/70 px-4 py-3 backdrop-blur">
                <dt class="sr-only">{l}</dt>
                <dd class="font-mono text-2xl font-bold tracking-tight">{n}</dd>
                <dd class="text-xs text-muted">{l}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="relative animate-fade-up [animation-delay:120ms]">
        <div class="relative rounded-[2rem] border border-border bg-surface/80 p-4 shadow-[0_30px_80px_-30px_color-mix(in_oklab,var(--brand)_45%,transparent)] backdrop-blur sm:p-6">
          <div class="mb-2 flex items-center gap-1.5">
            <span class="size-2.5 rounded-full bg-danger/70"></span>
            <span class="size-2.5 rounded-full bg-warning/70"></span>
            <span class="size-2.5 rounded-full bg-success/70"></span>
            <span class="ml-3 font-mono text-xs text-muted">dijkstra(A) · bfs · max-flow</span>
          </div>
          <HeroVisual />
        </div>
        <span class="glass animate-float absolute -top-4 -left-3 hidden rounded-2xl border border-border px-3.5 py-2 font-mono text-sm font-semibold shadow-lg sm:block">
          dist(A, H) = <span class="text-accent">8</span>
        </span>
        <span class="glass animate-float absolute -right-2 bottom-10 hidden rounded-2xl border border-border px-3.5 py-2 font-mono text-sm font-semibold shadow-lg [animation-delay:-3s] sm:block">
          O(n log n)
        </span>
        <span class="glass animate-float absolute -bottom-5 left-10 hidden rounded-2xl border border-border px-3.5 py-2 font-mono text-sm font-semibold shadow-lg [animation-delay:-1.5s] sm:block">
          max-flow = <span class="text-success">min-cut</span>
        </span>
      </div>
    </div>
  </section>

  <!-- ===================================================== CURRENT LAB -->
  {
    latest && (
      <section class="container-page">
        <div class="relative overflow-hidden rounded-[2rem] border border-border bg-surface p-6 shadow-surface sm:p-10">
          <div class="pointer-events-none absolute -top-40 -right-40 size-[30rem]" style="background: radial-gradient(closest-side, var(--glow-1), transparent)" />
          <div class="relative grid grid-cols-1 gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-center">
            <div>
              <p class="text-xs font-semibold tracking-wider text-accent uppercase">Laboratori i javës · Java {latest.week}</p>
              <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance">{latest.title}</h2>
              <p class="mt-3 max-w-2xl text-muted">{latest.summary}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={`${base}laboratoret/${latest.slug}/`} class="button button--primary gap-2">
                  Hap laboratorin <ArrowRight className="size-4" />
                </a>
                {latest.resources[0] && (
                  <a href={`${base}shkarkime/${latest.resources[0].notebook}`} download class="button button--tertiary gap-2">
                    <Download className="size-4" /> Fletorja .ipynb
                  </a>
                )}
              </div>
            </div>
            <ul class="grid gap-2">
              {latestViz.slice(0, 4).map((v) => {
                const Icon = VIZ_ICON[v.viz];
                const m = vizMeta(v.viz);
                return (
                  <li>
                    <a href={`${base}laboratoret/${latest.slug}/#${v.anchor}`} class="flex items-center gap-3 rounded-2xl border border-border bg-surface-secondary/60 p-3 transition-colors hover:border-accent/40">
                      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand to-brand-2 text-white">
                        {Icon && <Icon className="size-5" />}
                      </span>
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-semibold">{v.title ?? m?.title}</span>
                        <span class="block truncate text-xs text-muted">{m?.tagline}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <!-- ======================================================== SYLLABUS -->
  <section id="programi" class="container-page mt-24 scroll-mt-24">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-wider text-accent uppercase">Programi</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Katër blloqe, një rrugë</h2>
      <p class="mt-3 text-muted">Laboratorët ndjekin leksionet e lëndës: çdo koncept i leksionit ka një ushtrim dhe një vizualizim ku mund ta provoni.</p>
    </div>
    <div class="mt-10 flex flex-col gap-12">
      {
        blocks.map((b, i) => {
          const Icon = BLOCK_ICON[b.id];
          const blockLabs = labs.filter((l) => b.labs.includes(l.n));
          if (!blockLabs.length) return null;
          return (
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-[17rem_1fr]">
              <div class="lg:sticky lg:top-24 lg:self-start">
                <span class="grid size-12 place-items-center rounded-2xl text-white shadow-lg" style={`background: ${BLOCK_COLOR[b.id]}`}>
                  {Icon && <Icon className="size-6" />}
                </span>
                <p class="mt-4 font-mono text-xs font-semibold text-muted">BLLOKU {i + 1}</p>
                <h3 class="mt-1 text-xl font-bold tracking-tight">{b.name}</h3>
                {b.lectures && (
                  <span class="chip chip--default chip--sm chip--secondary mt-2">
                    <span class="chip__label">{b.lectures}</span>
                  </span>
                )}
              </div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {blockLabs.map((l) => (
                  <LabCard lab={l} block={b.id} />
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ================================================== VISUALIZATIONS -->
  <section class="container-page mt-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-wider text-accent uppercase">Vizualizimet</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Shihni algoritmet duke punuar</h2>
        <p class="mt-3 text-muted">Hap pas hapi, me pseudokodin e leksionit dhe me grafet e vetë laboratorëve. Pa instalim, edhe në telefon.</p>
      </div>
      <a href={`${base}vizualizime/`} class="button button--secondary gap-2">Të gjitha <ArrowRight className="size-4" /></a>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        viz.slice(0, 6).map((v) => {
          const Icon = VIZ_ICON[v.id];
          return (
            <a href={`${base}vizualizime/${v.id}/`} class="group card-hover flex gap-4 rounded-3xl border border-border bg-surface p-5 shadow-surface">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand to-brand-2 text-white shadow-md transition-transform duration-300 group-hover:scale-105">
                {Icon && <Icon className="size-6" />}
              </span>
              <span class="min-w-0">
                <span class="block font-semibold tracking-tight">{v.title}</span>
                <span class="mt-1 block text-sm text-muted">{v.tagline}</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ============================================================= HOW -->
  <section class="container-page mt-28">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        [
          { icon: BookOpenCheck, title: 'Lexoni teorinë', text: 'Çdo laborator nis me konceptet e leksionit, pseudokodin dhe shembujt e zgjidhur.' },
          { icon: MousePointerClick, title: 'Provojeni në shfletues', text: 'Çdo ushtrim që hapte një dritare Pygame ka versionin e vet interaktiv në faqe.' },
          { icon: Sparkles, title: 'Zgjidhni ushtrimet', text: 'Shkarkoni fletoren .ipynb dhe punoni në Jupyter, VS Code ose Google Colab.' },
        ].map((s, i) => (
          <div class="rounded-3xl border border-border bg-surface p-6 shadow-surface">
            <div class="flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-2xl bg-accent-soft text-accent">
                <s.icon className="size-5" />
              </span>
              <span class="font-mono text-sm font-semibold text-muted">0{i + 1}</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
