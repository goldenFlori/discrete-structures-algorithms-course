---
import Base from '../layouts/Base.astro';
import data from '../generated/course.json';

const base = import.meta.env.BASE_URL;
const packages = data.packages as any[];
const labs = (data.labs as any[]).filter((l) => l.isPublic);

// Only what the notebooks actually import. Nothing invented.
const pipLine = packages.filter((p) => p.pip).map((p) => p.pip).join(' ');
const ROLE: Record<string, { label: string; cls: string; note: string }> = {
  desktop: { label: 'Vetëm desktop', cls: 'badge-warn', note: 'Hap dritare — nuk punon në Colab apo në shfletues' },
  browser: { label: 'Punon kudo', cls: 'badge-ok', note: 'Punon në Jupyter lokal dhe në Colab' },
  kernel: { label: 'Kërkon kernel', cls: 'badge-neutral', note: 'Kontrollet punojnë vetëm me kernel Jupyter aktiv' },
  'stdlib-desktop': { label: 'Vjen me Python', cls: 'badge-neutral', note: 'Hap dritare desktop; në Linux mund të kërkojë python3-tk' },
  bundled: { label: 'Vjen me Jupyter', cls: 'badge-neutral', note: 'Instalohet bashkë me Jupyter' },
};
---

<Base
  title="Python & Setup"
  description="Çfarë të instaloni për laboratorët, si t'i hapni fletoret dhe si të zgjidhni gabimet e zakonshme."
>
  <div class="page">
    <header class="page-head">
      <h1>Python &amp; Setup</h1>
      <p class="lede">
        Gjithçka që ju duhet për të hapur dhe ekzekutuar fletoret e kësaj lënde.
        Lista e paketave është nxjerrë <strong>drejtpërdrejt nga importet</strong> e fletoreve —
        asgjë nuk është shtuar "për çdo rast".
      </p>
    </header>

    {/* ----------------------------------------------------- quick start */}
    <section id="fillimi" class="sec">
      <h2>1 · Instalimi në tri hapa</h2>

      <ol class="steps">
        <li>
          <h3>Instaloni Python</h3>
          <p>
            Shkarkoni Python 3.11 ose më të ri nga
            <a href="https://www.python.org/downloads/" target="_blank" rel="noopener noreferrer">python.org/downloads</a>.
          </p>
          <p class="callout callout-warn" style="margin:.6rem 0 0">
            <strong>Në Windows:</strong> gjatë instalimit shënoni kutinë
            <em>“Add Python to PATH”</em>. Pa të, komandat më poshtë nuk do të funksionojnë.
          </p>
        </li>

        <li>
          <h3>Krijoni një mjedis të veçuar</h3>
          <p>Kjo e mban lëndën të ndarë nga pjesa tjetër e sistemit tuaj.</p>
          <div class="code-pair">
            <div>
              <h4>Windows</h4>
              <pre><code>python -m venv .venv
.venv\Scripts\activate</code></pre>
            </div>
            <div>
              <h4>macOS / Linux</h4>
              <pre><code>python3 -m venv .venv
source .venv/bin/activate</code></pre>
            </div>
          </div>
        </li>

        <li>
          <h3>Instaloni paketat</h3>
          <p>Një komandë e vetme mbulon të gjithë laboratorët e publikuar:</p>
          <pre class="cmd"><code>pip install {pipLine} jupyterlab</code></pre>
          <p class="muted">
            Nuk ju duhen të gjitha për çdo laborator — shihni tabelën më poshtë nëse doni
            të instaloni vetëm ato që ju duhen tani.
          </p>
        </li>
      </ol>
    </section>

    {/* -------------------------------------------------------- packages */}
    <section id="paketat" class="sec">
      <h2>2 · Çfarë kërkon secili laborator</h2>
      <p class="muted">
        Kjo tabelë gjenerohet automatikisht nga importet reale të fletoreve. Kur shtohet
        një laborator i ri, ajo përditësohet vetë.
      </p>

      <div class="table-wrap">
        <table class="pkg-table">
          <thead>
            <tr>
              <th scope="col">Paketa</th>
              <th scope="col">Për çfarë</th>
              <th scope="col">Ku punon</th>
              <th scope="col">Laboratorët</th>
            </tr>
          </thead>
          <tbody>
            {packages.map((p) => {
              const role = ROLE[p.role] ?? ROLE.browser;
              return (
                <tr>
                  <th scope="row"><code>{p.name}</code></th>
                  <td>{p.label}</td>
                  <td><span class={`badge ${role.cls}`} title={role.note}>{role.label}</span></td>
                  <td class="c-labs">
                    {p.labs.length
                      ? p.labs.map((n: number) => (
                          <a class="chip" href={`${base}laboratoret/${String(n).padStart(2, '0')}/`}>{String(n).padStart(2, '0')}</a>
                        ))
                      : <span class="muted">vetëm te detyrat</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <h3>Për çdo laborator veç e veç</h3>
      <div class="lab-deps">
        {labs.map((l) => (
          <div class="dep-card">
            <a href={`${base}laboratoret/${l.slug}/`}><strong>Lab {l.slug}</strong></a>
            <code>{l.dependencies.length ? `pip install ${l.dependencies.join(' ')}` : 'asnjë paketë shtesë'}</code>
            {(l.flags.pygame || l.flags.tkinter) && <span class="badge badge-warn">Dritare desktop</span>}
          </div>
        ))}
      </div>
    </section>

    {/* ------------------------------------------------------- notebooks */}
    <section id="hapja" class="sec">
      <h2>3 · Si t'i hapni fletoret</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>JupyterLab</h3>
          <pre><code>jupyter lab</code></pre>
          <p>Hapet në shfletues. Shkoni te dosja ku ruajtët <code>.ipynb</code> dhe klikojeni.</p>
        </div>
        <div class="card">
          <h3>Jupyter Notebook</h3>
          <pre><code>jupyter notebook</code></pre>
          <p>Ndërfaqja klasike. Funksionon njësoj për të gjitha materialet e lëndës.</p>
        </div>
        <div class="card">
          <h3>VS Code</h3>
          <p>
            Instaloni zgjerimin <em>Python</em> dhe <em>Jupyter</em>, pastaj hapni skedarin
            <code>.ipynb</code> drejtpërdrejt. Zgjidhni mjedisin <code>.venv</code> si kernel.
          </p>
        </div>
      </div>

      <h3>Ekzekutimi i qelizave</h3>
      <ul class="keys">
        <li><kbd>Shift</kbd> + <kbd>Enter</kbd> — ekzekuto qelizën dhe kalo te tjetra</li>
        <li><kbd>Ctrl</kbd> + <kbd>Enter</kbd> — ekzekuto qelizën dhe qëndro aty</li>
        <li>Qelizat ekzekutohen <strong>me radhë</strong>: nëse një qelizë varet nga një e mëparshme, ekzekutoni fillimisht atë.</li>
      </ul>
    </section>

    {/* -------------------------------------------------- desktop windows */}
    <section id="dritaret-desktop" class="sec">
      <h2>4 · Ushtrimet që hapin dritare (Pygame &amp; Tkinter)</h2>

      <div class="callout callout-warn">
        <p class="callout-title">Këto nuk punojnë në Google Colab</p>
        <p style="margin:0">
          Pjesa më e madhe e vizualizimeve në këtë lëndë hapin një dritare të vërtetë në
          kompjuterin tuaj. Colab ekzekutohet në një server pa ekran, prandaj aty do të merrni
          gabimin <code>pygame.error: video system not initialized</code> ose thjesht asgjë.
          Ekzekutojini <strong>lokalisht</strong>.
        </p>
      </div>

      <h3>Si të punoni me to</h3>
      <ol>
        <li>Ekzekutoni qelizën. Dritarja hapet <strong>mbi ose pas</strong> shfletuesit — kërkojeni në shiritin e detyrave.</li>
        <li>Përdorni tastet që përshkruan qeliza Markdown mbi kod (zakonisht <kbd>SPACE</kbd>, <kbd>R</kbd>, <kbd>Q</kbd>, shigjetat).</li>
        <li>Mbylleni dritaren kur të keni mbaruar.</li>
      </ol>

      <div class="callout callout-info">
        <p class="callout-title">Gjurma <code>SystemExit</code> pas mbylljes është normale</p>
        <p style="margin:0">
          Kur mbyllni dritaren, Jupyter shpesh shfaq një <code>SystemExit</code> ose
          “Kernel crashed”. <strong>Kjo nuk do të thotë se algoritmi dështoi</strong> — është
          thjesht programi desktop që mbaron. Në këtë faqe ato gjurmë shfaqen si shënime
          neutrale, jo si gabime.
        </p>
      </div>

      <p>
        Nëse nuk arrini t'i ekzekutoni, të njëjtat algoritme ecin hap pas hapi te
        <a href={`${base}vizualizime/`}>Vizualizimet</a>, drejtpërdrejt në shfletues.
      </p>
    </section>

    {/* ---------------------------------------------------- common errors */}
    <section id="gabimet" class="sec">
      <h2>5 · Gabimet që do të hasni</h2>

      <div class="errors">
        <details class="err">
          <summary><code>ModuleNotFoundError: No module named 'pygame'</code></summary>
          <p>
            Paketa nuk është instaluar, ose Jupyter po përdor një Python tjetër nga ai ku e instaluat.
            Ekzekutoni brenda një qelize të vetë fletores:
          </p>
          <pre><code>import sys
!{'{sys.executable}'} -m pip install pygame</code></pre>
          <p class="muted">Kjo instalon gjithmonë në të njëjtin Python që po përdor fletorja.</p>
        </details>

        <details class="err">
          <summary><code>pygame.error: video system not initialized</code></summary>
          <p>
            Nuk ka ekran në dispozicion. Kjo ndodh në Google Colab, në një server, ose kur kerneli
            u ristartua pasi mbyllët dritaren. Ekzekutojeni lokalisht dhe ri-ekzekutoni qelizën nga fillimi.
          </p>
        </details>

        <details class="err">
          <summary><code>NameError: name 'plt' is not defined</code> (ose <code>go</code>, <code>nx</code>, <code>np</code>)</summary>
          <p>
            Qeliza përdor një bibliotekë që nuk e ka importuar, ose ju ekzekutuat qelizat jashtë radhe.
            Së pari provoni <em>Run All</em> nga fillimi. Nëse gabimi mbetet, shtoni importin që mungon:
          </p>
          <pre><code>import matplotlib.pyplot as plt
import plotly.graph_objects as go
import networkx as nx
import numpy as np</code></pre>
        </details>

        <details class="err">
          <summary>Dritarja hapet, por ngrin ose nuk përgjigjet</summary>
          <p>
            Mos e ekzekutoni të njëjtën qelizë dy herë pa e mbyllur dritaren e parë. Mbyllni dritaren,
            pastaj <em>Kernel → Restart</em> dhe ekzekutojeni sërish.
          </p>
        </details>

        <details class="err">
          <summary>Butonat e një ushtrimi nuk reagojnë (ipywidgets)</summary>
          <p>
            Kontrollet <code>ipywidgets</code> kërkojnë një kernel aktiv. Ato nuk funksionojnë
            në një fletore të ruajtur, as në këtë faqe. Instaloni dhe ekzekutoni lokalisht:
          </p>
          <pre><code>pip install ipywidgets</code></pre>
        </details>

        <details class="err">
          <summary>Në Linux: <code>ModuleNotFoundError: No module named 'tkinter'</code></summary>
          <p>Tkinter vjen me Python, por në disa distribucione paketohet veçmas:</p>
          <pre><code>sudo apt install python3-tk</code></pre>
        </details>
      </div>
    </section>

    <section class="sec">
      <h2>Ende nuk funksionon?</h2>
      <p>
        Shkruani në Google Classroom duke përfshirë: sistemin tuaj operativ, laboratorin,
        numrin e ushtrimit dhe <strong>tekstin e plotë të gabimit</strong>. Kjo e bën zgjidhjen
        shumë më të shpejtë sesa “nuk më punon”.
      </p>
    </section>
  </div>
</Base>

<style>
  .page { padding: 2rem 0 3rem; max-width: 900px; }
  .page-head { max-width: 720px; margin-bottom: 1rem; }
  .lede { color: var(--ink-2); font-size: 1.02rem; }

  .sec { margin-top: 3rem; scroll-margin-top: calc(var(--nav-h) + 20px); }
  .sec > h2 {
    font-size: 1.15rem; margin: 0 0 .8rem;
    padding-bottom: .5rem; border-bottom: 1px solid var(--border);
  }
  .sec h3 { font-size: 1rem; margin-top: 1.8rem; }
  .sec p, .sec li { max-width: var(--measure); }

  .steps { list-style: none; padding: 0; counter-reset: s; }
  .steps > li {
    counter-increment: s; position: relative;
    padding-left: 2.6rem; margin: 0 0 2rem;
  }
  .steps > li::before {
    content: counter(s);
    position: absolute; left: 0; top: .1rem;
    width: 30px; height: 30px; display: grid; place-items: center;
    border-radius: 50%; background: var(--accent); color: #fff;
    font: 700 .85rem/1 var(--font-mono);
  }
  .steps h3 { margin: .2rem 0 .5rem; font-size: 1.02rem; }

  pre {
    margin: .6rem 0; padding: .75em 1em; overflow-x: auto;
    background: var(--code-bg); border: 1px solid var(--code-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono); font-size: .84rem; line-height: 1.6;
  }
  pre.cmd { background: var(--accent-soft); border-color: var(--accent-line); }
  pre code { background: none; border: 0; padding: 0; }

  .code-pair { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .code-pair h4 { margin: 0; font-size: .74rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }

  .table-wrap { position: relative; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .pkg-table { min-width: 620px; }
  .pkg-table th[scope='row'] { background: transparent; }
  .pkg-table td { vertical-align: middle; }
  .c-labs { display: flex; flex-wrap: wrap; gap: .25rem; }
  .c-labs .chip { font-family: var(--font-mono); font-size: .72rem; text-decoration: none; }

  .lab-deps { display: grid; gap: .5rem; }
  .dep-card {
    display: flex; flex-wrap: wrap; align-items: center; gap: .7rem;
    padding: .55rem .8rem; border: 1px solid var(--border);
    border-radius: var(--radius-sm); background: var(--surface);
  }
  .dep-card a { text-decoration: none; flex: none; min-width: 4.5rem; }
  .dep-card code { font-size: .8rem; flex: 1; min-width: 200px; }

  .keys { list-style: none; padding: 0; }
  .keys li { margin: .5em 0; }
  kbd {
    font-family: var(--font-mono); font-size: .8em;
    padding: .15em .45em; border: 1px solid var(--border-strong);
    border-bottom-width: 2px; border-radius: 4px; background: var(--surface-2);
  }

  .errors { display: grid; gap: .5rem; }
  .err { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); }
  .err > summary {
    cursor: pointer; padding: .75em 1em; font-size: .9rem;
    list-style: none; display: flex; align-items: center; gap: .5rem;
  }
  .err > summary::-webkit-details-marker { display: none; }
  .err > summary::before { content: '▸'; color: var(--ink-faint); flex: none; }
  .err[open] > summary::before { content: '▾'; }
  .err > summary:hover { background: var(--surface-2); }
  .err > summary code { font-size: .82em; }
  .err > :not(summary) { margin-left: 1em; margin-right: 1em; }
  .err > :last-child { margin-bottom: 1em; }
</style>
