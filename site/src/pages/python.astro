---
import { AppWindow, ChevronDown, Cloud, Laptop, MonitorSmartphone, TriangleAlert, Wrench } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import data from '../generated/course.json';

const packages = (data.packages as any[]).filter((p) => p.pip);
const pipLine = ['pip install', ...packages.map((p) => p.pip), 'jupyterlab'].join(' ');
const labs = (data.labs as any[]).filter((l) => l.isPublic);

const errors = [
  {
    q: "ModuleNotFoundError: No module named 'pygame'",
    a: 'Paketa nuk është instaluar, ose Jupyter po përdor një Python tjetër. Ekzekutoni brenda një qelize të fletores:',
    code: 'import sys\n!{sys.executable} -m pip install pygame',
  },
  {
    q: 'pygame.error: video system not initialized',
    a: 'Nuk ka ekran: kjo ndodh në Google Colab ose pasi kerneli u ristartua. Ekzekutojeni lokalisht dhe nisni qelizat nga fillimi. Në faqe, versioni interaktiv i ushtrimit punon pa Pygame.',
  },
  {
    q: "NameError: name 'plt' is not defined (ose go, nx, np)",
    a: 'Qelizat u ekzekutuan jashtë radhe. Provoni Run All nga fillimi; nëse mbetet, shtoni importin që mungon:',
    code: 'import matplotlib.pyplot as plt\nimport plotly.graph_objects as go\nimport networkx as nx\nimport numpy as np',
  },
  {
    q: 'Dritarja hapet, por ngrin',
    a: 'Mos e ekzekutoni të njëjtën qelizë dy herë pa e mbyllur dritaren e parë. Mbylleni, pastaj Kernel → Restart dhe ekzekutoni sërish.',
  },
  {
    q: "Linux: No module named 'tkinter'",
    a: 'Tkinter vjen me Python, por në disa distribucione paketohet veçmas:',
    code: 'sudo apt install python3-tk',
  },
];
---

<Layout title="Mjedisi i punës" description="Si t'i hapni dhe t'i ekzekutoni fletoret e laboratorit: Colab, Jupyter, VS Code.">
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_80%_at_50%_0%,black,transparent)]"></div>
    <div class="container-page relative pt-14 pb-6">
      <p class="text-xs font-semibold tracking-wider text-accent uppercase">Python · Jupyter · Colab</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Mjedisi i punës</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">Gjithçka që ju duhet për të ekzekutuar fletoret e laboratorit — nga Google Colab pa instalim, te Jupyter në kompjuterin tuaj.</p>
    </div>
  </section>

  <div class="container-page mt-8 grid gap-6">
    <!-- Colab -->
    <section class="grid grid-cols-1 gap-6 rounded-3xl border border-border bg-surface p-6 shadow-surface sm:p-8 lg:grid-cols-[auto_1fr]">
      <span class="grid size-12 place-items-center rounded-2xl bg-accent-soft text-accent"><Cloud className="size-6" /></span>
      <div>
        <h2 class="text-xl font-bold tracking-tight">Më e shpejta: Google Colab</h2>
        <p class="mt-2 text-muted">
          Ushtrimet shtesë, Laboratori 10 dhe detyrat nuk kërkojnë Pygame: hapen me butonin <b class="text-foreground">Hap në Google Colab</b> në faqen e tyre
          dhe punojnë menjëherë në shfletues, pa instaluar asgjë.
        </p>
      </div>
    </section>

    <!-- Local install -->
    <section class="rounded-3xl border border-border bg-surface p-6 shadow-surface sm:p-8">
      <div class="flex items-center gap-3">
        <span class="grid size-12 place-items-center rounded-2xl bg-accent-soft text-accent"><Laptop className="size-6" /></span>
        <h2 class="text-xl font-bold tracking-tight">Në kompjuterin tuaj, në tri hapa</h2>
      </div>
      <ol class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-3">
        <li class="rounded-2xl bg-surface-secondary p-5">
          <span class="font-mono text-xs font-bold text-accent">01</span>
          <h3 class="mt-1 font-semibold">Instaloni Python</h3>
          <p class="mt-2 text-sm text-muted">Python 3.11 ose më i ri nga <a class="text-accent underline underline-offset-2" href="https://www.python.org/downloads/" target="_blank" rel="noopener noreferrer">python.org</a>.</p>
          <p class="mt-3 rounded-xl border border-warning/40 bg-warning-soft/50 p-3 text-xs"><b>Windows:</b> shënoni kutinë “Add Python to PATH” gjatë instalimit.</p>
        </li>
        <li class="rounded-2xl bg-surface-secondary p-5">
          <span class="font-mono text-xs font-bold text-accent">02</span>
          <h3 class="mt-1 font-semibold">Krijoni një mjedis të veçuar</h3>
          <p class="mt-2 text-xs text-muted">Windows</p>
          <pre class="mt-1 overflow-x-auto rounded-xl bg-[var(--code-bg)] p-3 font-mono text-xs">python -m venv .venv
.venv\Scripts\activate</pre>
          <p class="mt-3 text-xs text-muted">macOS / Linux</p>
          <pre class="mt-1 overflow-x-auto rounded-xl bg-[var(--code-bg)] p-3 font-mono text-xs">python3 -m venv .venv
source .venv/bin/activate</pre>
        </li>
        <li class="rounded-2xl bg-surface-secondary p-5">
          <span class="font-mono text-xs font-bold text-accent">03</span>
          <h3 class="mt-1 font-semibold">Instaloni paketat</h3>
          <p class="mt-2 text-sm text-muted">Një komandë mbulon të gjithë laboratorët:</p>
          <pre class="mt-2 overflow-x-auto rounded-xl bg-[var(--code-bg)] p-3 font-mono text-xs whitespace-pre-wrap">{pipLine}</pre>
        </li>
      </ol>
      <details class="group mt-6 rounded-2xl border border-border">
        <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-3.5 text-sm font-medium select-none [&::-webkit-details-marker]:hidden">
          Çfarë kërkon secili laborator
          <ChevronDown className="size-4 transition-transform group-open:rotate-180" />
        </summary>
        <ul class="grid grid-cols-1 gap-2 border-t border-border p-4 sm:grid-cols-2">
          {
            labs.map((l) => (
              <li class="flex items-center gap-3 rounded-xl bg-surface-secondary px-3 py-2">
                <span class="font-mono text-xs font-bold text-accent">LAB {l.slug}</span>
                <code class="min-w-0 flex-1 truncate font-mono text-xs">{l.dependencies.length ? `pip install ${l.dependencies.join(' ')}` : 'asnjë paketë shtesë'}</code>
              </li>
            ))
          }
        </ul>
      </details>
    </section>

    <!-- Opening notebooks -->
    <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        [
          { t: 'JupyterLab', c: 'jupyter lab', d: 'Hapet në shfletues. Gjeni skedarin .ipynb dhe klikojeni.' },
          { t: 'Jupyter Notebook', c: 'jupyter notebook', d: 'Ndërfaqja klasike — funksionon njësoj për të gjitha materialet.' },
          { t: 'VS Code', c: '', d: 'Instaloni zgjerimet Python dhe Jupyter, hapni .ipynb dhe zgjidhni .venv si kernel.' },
        ].map((x) => (
          <div class="rounded-3xl border border-border bg-surface p-6 shadow-surface">
            <AppWindow className="size-5 text-accent" />
            <h3 class="mt-3 font-semibold">{x.t}</h3>
            {x.c && <pre class="mt-2 rounded-xl bg-[var(--code-bg)] p-2.5 font-mono text-xs">{x.c}</pre>}
            <p class="mt-2 text-sm text-muted">{x.d}</p>
          </div>
        ))
      }
    </section>

    <!-- Desktop windows -->
    <section id="dritaret-desktop" class="grid grid-cols-1 gap-6 rounded-3xl border border-border bg-surface p-6 shadow-surface sm:p-8 lg:grid-cols-[auto_1fr]">
      <span class="grid size-12 place-items-center rounded-2xl bg-warning-soft text-warning"><MonitorSmartphone className="size-6" /></span>
      <div>
        <h2 class="text-xl font-bold tracking-tight">Ushtrimet me dritare (Pygame & Tkinter)</h2>
        <p class="mt-2 text-muted">
          Disa ushtrime hapin një dritare të vërtetë në kompjuterin tuaj, prandaj nuk punojnë në Colab. Në faqe, secili prej tyre ka
          <b class="text-foreground">versionin e vet interaktiv</b> në shfletues; kodi Python është i palosur poshtë tij.
        </p>
        <ol class="mt-4 list-decimal space-y-1.5 pl-5 text-sm text-muted">
          <li>Ekzekutoni qelizën; dritarja hapet mbi ose pas shfletuesit.</li>
          <li>Përdorni tastet që përshkruan teksti mbi kod (zakonisht SPACE, R, Q, shigjetat).</li>
          <li>Mbylleni dritaren kur të mbaroni. Një <code class="font-mono">SystemExit</code> pas mbylljes është normal.</li>
        </ol>
      </div>
    </section>

    <!-- Errors -->
    <section class="rounded-3xl border border-border bg-surface p-6 shadow-surface sm:p-8">
      <div class="flex items-center gap-3">
        <span class="grid size-12 place-items-center rounded-2xl bg-danger-soft text-danger"><TriangleAlert className="size-6" /></span>
        <h2 class="text-xl font-bold tracking-tight">Gabimet që do të hasni</h2>
      </div>
      <div class="mt-6 divide-y divide-separator rounded-2xl border border-border">
        {
          errors.map((e) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 select-none [&::-webkit-details-marker]:hidden">
                <code class="font-mono text-sm">{e.q}</code>
                <ChevronDown className="size-4 shrink-0 text-muted transition-transform group-open:rotate-180" />
              </summary>
              <div class="px-5 pb-5 text-sm text-muted">
                <p>{e.a}</p>
                {e.code && <pre class="mt-3 overflow-x-auto rounded-xl bg-[var(--code-bg)] p-3 font-mono text-xs text-foreground">{e.code}</pre>}
              </div>
            </details>
          ))
        }
      </div>
      <p class="mt-5 flex items-center gap-2 text-sm text-muted"><Wrench className="size-4" /> Ende nuk funksionon? Sillni kompjuterin në orën e laboratorit — e zgjidhim bashkë.</p>
    </section>
  </div>
</Layout>
