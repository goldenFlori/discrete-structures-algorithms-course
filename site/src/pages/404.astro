---
import { ArrowLeft } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Faqja nuk u gjet" indexable={false}>
  <section class="container-page grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="text-gradient font-mono text-7xl font-extrabold">404</p>
      <h1 class="mt-4 text-2xl font-bold tracking-tight">Kjo rrugë nuk ekziston në graf</h1>
      <p class="mt-2 text-muted">Asnjë shteg nga këtu te faqja që kërkuat — por kreu është gjithmonë i arritshëm.</p>
      <a href={base} class="button button--primary mt-8 gap-2"><ArrowLeft className="size-4" /> Kthehu në kreu</a>
    </div>
  </section>
</Layout>
