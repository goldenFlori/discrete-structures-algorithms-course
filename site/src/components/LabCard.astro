---
import { ArrowRight, Sparkles } from 'lucide-react';
import { BLOCK_COLOR } from '../lib/icons';

interface Props {
  lab: any;
  block?: string;
  compact?: boolean;
}
const { lab, block = 'renditja', compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const vizCount = (lab.viz as any[]).length;
const color = BLOCK_COLOR[block] ?? 'var(--brand)';
---

<a
  href={`${base}laboratoret/${lab.slug}/`}
  class="group card-hover relative flex h-full flex-col overflow-hidden rounded-3xl border border-border bg-surface p-5 shadow-surface"
  style={`--block:${color}`}
>
  <span class="pointer-events-none absolute -top-20 -right-20 size-48 opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: radial-gradient(closest-side, color-mix(in oklab, var(--block) 30%, transparent), transparent)"></span>
  <div class="flex items-center justify-between gap-2">
    <span class="font-mono text-xs font-bold tracking-wider" style="color: var(--block)">LAB {lab.slug}</span>
    {lab.lecture && <span class="chip chip--default chip--sm chip--secondary"><span class="chip__label">{lab.lecture}</span></span>}
  </div>
  <h3 class="mt-3 text-[1.05rem] leading-snug font-semibold tracking-tight text-balance">{lab.title}</h3>
  {!compact && <p class="mt-2 line-clamp-3 text-sm text-muted">{lab.summary}</p>}
  <div class="mt-auto flex items-center gap-2 pt-5 text-xs text-muted">
    <Sparkles className="size-3.5" style={{ color }} />
    <span>{vizCount} {vizCount === 1 ? 'ushtrim interaktiv' : 'ushtrime interaktive'}</span>
    <ArrowRight className="ml-auto size-4 transition-transform duration-300 group-hover:translate-x-1" />
  </div>
</a>
