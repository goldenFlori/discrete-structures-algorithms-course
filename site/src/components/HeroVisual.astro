---
/**
 * Decorative hero illustration: a BFS wave spreads over a network, then the
 * shortest path lights up and particles flow along it. Pure SVG + CSS.
 */
const nodes = [
  { id: 'A', x: 70, y: 210, d: 0 },
  { id: 'B', x: 190, y: 90, d: 1 },
  { id: 'C', x: 200, y: 300, d: 1 },
  { id: 'D', x: 330, y: 170, d: 2 },
  { id: 'E', x: 330, y: 330, d: 2 },
  { id: 'F', x: 460, y: 80, d: 3 },
  { id: 'G', x: 470, y: 250, d: 3 },
  { id: 'H', x: 580, y: 170, d: 4 },
];
const edges = [
  ['A', 'B', 4], ['A', 'C', 2], ['B', 'D', 5], ['C', 'D', 1], ['C', 'E', 8], ['B', 'F', 10],
  ['D', 'F', 2], ['D', 'G', 6], ['E', 'G', 3], ['F', 'H', 3], ['G', 'H', 1],
] as const;
const path = ['A', 'C', 'D', 'F', 'H'];
const at = (id: string) => nodes.find((n) => n.id === id)!;
const pathD = path.map((id, i) => `${i ? 'L' : 'M'} ${at(id).x} ${at(id).y}`).join(' ');
const onPath = (u: string, v: string) => path.some((p, i) => i < path.length - 1 && ((p === u && path[i + 1] === v) || (p === v && path[i + 1] === u)));
---

<div class="hero-visual relative" aria-hidden="true">
  <svg viewBox="0 0 650 400" class="h-auto w-full">
    <defs>
      <linearGradient id="hv-path" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--brand)" />
        <stop offset="1" stop-color="var(--brand-2)" />
      </linearGradient>
      <filter id="hv-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>
    {
      edges.map(([u, v, w]) => (
        <g>
          <line x1={at(u).x} y1={at(u).y} x2={at(v).x} y2={at(v).y} stroke="var(--border)" stroke-width="2.5" />
          <text x={(at(u).x + at(v).x) / 2} y={(at(u).y + at(v).y) / 2 - 7} text-anchor="middle" font-size="12" font-family="var(--font-mono)" fill={onPath(u, v) ? 'var(--accent)' : 'var(--muted)'} font-weight="600">
            {w}
          </text>
        </g>
      ))
    }
    <path d={pathD} fill="none" stroke="url(#hv-path)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" filter="url(#hv-glow)" class="hv-glow" opacity="0.5" />
    <path d={pathD} fill="none" stroke="url(#hv-path)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" class="hv-path" pathLength="100" />
    <path d={pathD} fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-dasharray="1.5 10" class="hv-particles" pathLength="100" opacity="0.9" />
    {
      nodes.map((n) => (
        <g style={`--d:${n.d}`} class="hv-node">
          <circle cx={n.x} cy={n.y} r="26" class="hv-wave" fill="none" stroke="var(--accent)" stroke-width="2" />
          <circle cx={n.x} cy={n.y} r="20" fill="var(--surface)" stroke={path.includes(n.id) ? 'var(--accent)' : 'var(--viz-line)'} stroke-width="2.5" />
          <text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="central" font-size="14" font-weight="700" fill="var(--foreground)">
            {n.id}
          </text>
        </g>
      ))
    }
  </svg>
</div>

<style>
  .hv-path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: hv-draw 6s var(--ease-out-quart) infinite;
  }
  .hv-glow {
    opacity: 0;
    animation: hv-glow 6s ease-in-out infinite;
  }
  .hv-particles {
    opacity: 0;
    animation:
      hv-flow 1.4s linear infinite,
      hv-show 6s ease-in-out infinite;
  }
  .hv-wave {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: hv-wave 6s ease-out infinite;
    animation-delay: calc(var(--d) * 0.35s);
  }
  @keyframes hv-wave {
    0% { opacity: 0; transform: scale(0.7); }
    6% { opacity: 0.9; }
    22% { opacity: 0; transform: scale(1.55); }
    100% { opacity: 0; }
  }
  @keyframes hv-draw {
    0%, 28% { stroke-dashoffset: 100; }
    55%, 88% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -100; }
  }
  @keyframes hv-glow {
    0%, 40% { opacity: 0; }
    60%, 85% { opacity: 0.45; }
    100% { opacity: 0; }
  }
  @keyframes hv-show {
    0%, 52% { opacity: 0; }
    60%, 85% { opacity: 0.9; }
    100% { opacity: 0; }
  }
  @keyframes hv-flow {
    to { stroke-dashoffset: -11.5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-path { animation: none; stroke-dashoffset: 0; }
    .hv-wave, .hv-glow, .hv-particles { animation: none; }
  }
</style>
