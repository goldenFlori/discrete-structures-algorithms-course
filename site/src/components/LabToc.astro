---
/**
 * "Në këtë laborator" — sticky on desktop, collapsed into a details element
 * on narrow screens so it never pushes the content off the first screen.
 */
interface Props { toc: any[]; title?: string }
const { toc, title = 'Në këtë laborator' } = Astro.props;

const KIND_DOT: Record<string, string> = {
  exercise: 'k-exercise',
  homework: 'k-homework',
  classwork: 'k-classwork',
  reflect: 'k-reflect',
  scenario: 'k-scenario',
  theory: 'k-theory',
};
---

{toc.length > 1 && (
  <nav class="lab-toc no-print" aria-labelledby="toc-title">
    <details class="toc-shell" open>
      <summary id="toc-title"><span>{title}</span><span class="toc-count">{toc.length}</span></summary>
      <ol class="toc-list">
        {toc.map((t) => (
          <li class={`toc-l${t.level} ${KIND_DOT[t.kind] || ''}`}>
            <a href={`#${t.id}`}>{t.title}</a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style>
  .lab-toc { font-size: .86rem; }

  .toc-shell > summary {
    cursor: pointer; list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    font-size: .72rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
    color: var(--ink-3); padding: .5em 0;
    border-bottom: 1px solid var(--border);
  }
  .toc-shell > summary::-webkit-details-marker { display: none; }
  .toc-count {
    font-family: var(--font-mono); font-size: .7rem; font-weight: 600;
    color: var(--ink-faint); letter-spacing: 0;
    background: var(--surface-2); border: 1px solid var(--border);
    border-radius: 999px; padding: .1em .55em;
  }

  .toc-list { list-style: none; margin: .6rem 0 0; padding: 0; }
  .toc-list li { margin: 0; }
  .toc-list a {
    display: block; padding: .32em .5em .32em .8em;
    color: var(--ink-2); text-decoration: none; line-height: 1.4;
    border-left: 2px solid var(--border);
    border-radius: 0 4px 4px 0;
  }
  .toc-list a:hover { color: var(--accent-ink); background: var(--accent-soft); border-left-color: var(--accent); }
  .toc-list a.is-current { color: var(--accent-ink); background: var(--accent-soft); border-left-color: var(--accent); font-weight: 600; }

  .toc-l3 a { padding-left: 1.6em; font-size: .93em; color: var(--ink-3); }

  /* Colour + a leading marker, so state never relies on colour alone. */
  .k-exercise  > a { border-left-color: var(--accent-line); }
  .k-homework  > a { border-left-color: var(--danger-line); }
  .k-classwork > a { border-left-color: var(--warn-line); }
  .k-reflect   > a { border-left-color: var(--violet-line); }
  .k-scenario  > a { border-left-color: var(--ok-line); }
  .k-homework  > a::before  { content: '◆ '; color: var(--danger); font-size: .7em; }
  .k-classwork > a::before  { content: '▲ '; color: var(--warn); font-size: .7em; }
  .k-reflect   > a::before  { content: '● '; color: var(--violet); font-size: .7em; }
  .k-scenario  > a::before  { content: '■ '; color: var(--ok); font-size: .7em; }

  @media (min-width: 1025px) {
    .lab-toc { position: sticky; top: calc(var(--nav-h) + 1.5rem); max-height: calc(100vh - var(--nav-h) - 3rem); overflow-y: auto; }
    .toc-shell > summary { pointer-events: none; }
  }
</style>

<script>
  // Highlight the section currently on screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-list a')];
  if (links.length) {
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    const targets = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    let current: HTMLAnchorElement | null = null;

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!visible.length) return;
        const link = byId.get(visible[0].target.id);
        if (link && link !== current) {
          current?.classList.remove('is-current');
          link.classList.add('is-current');
          current = link;
        }
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
    );
    for (const t of targets) io.observe(t);

    // On small screens the list is collapsed; tapping a link should close it.
    const shell = document.querySelector<HTMLDetailsElement>('.toc-shell');
    if (shell && matchMedia('(max-width: 1024px)').matches) {
      shell.open = false;
      for (const a of links) a.addEventListener('click', () => { shell.open = false; });
    }
  }
</script>
