---
import data from '../../generated/course.json';
import Logo from './Logo.astro';

const { course } = data;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const labs = (data.labs as any[]).filter((l) => l.isPublic);
---

<footer class="no-print mt-24 border-t border-separator bg-surface-secondary/40">
  <div class="container-page grid grid-cols-1 gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href={base} class="flex items-center gap-2.5">
        <Logo class="size-9" />
        <span class="font-semibold tracking-tight">{course.title}</span>
      </a>
      <p class="mt-3 max-w-sm text-sm text-muted">
        {course.component} · {course.program} · {course.year}{course.faculty ? ` · ${course.faculty}` : ''}.
      </p>
    </div>
    <nav aria-label="Laboratorët">
      <h2 class="text-xs font-semibold tracking-wider text-muted uppercase">Laboratorët</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        {
          labs.map((l) => (
            <li>
              <a href={`${base}laboratoret/${l.slug}/`} class="text-foreground/80 hover:text-accent">
                Laboratori {l.n}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Burime">
      <h2 class="text-xs font-semibold tracking-wider text-muted uppercase">Burime</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a href={`${base}vizualizime/`} class="text-foreground/80 hover:text-accent">Vizualizimet interaktive</a></li>
        <li><a href={`${base}detyrat/`} class="text-foreground/80 hover:text-accent">Detyrat e shtëpisë</a></li>
        <li><a href={`${base}python/`} class="text-foreground/80 hover:text-accent">Mjedisi i punës (Python, Jupyter, Colab)</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-separator">
    <div class="container-page flex flex-wrap items-center justify-between gap-2 py-5 text-xs text-muted">
      <span>© {year} · {course.title}</span>
      <span>Fletoret e laboratorit janë burimi akademik; vizualizimet punojnë direkt në shfletues.</span>
    </div>
  </div>
</footer>
