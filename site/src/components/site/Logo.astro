---
/** A small graph on the brand gradient: three vertices, one highlighted path. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg viewBox="0 0 40 40" class={cls} aria-hidden="true">
  <defs>
    <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--brand)" />
      <stop offset="1" stop-color="var(--brand-2)" />
    </linearGradient>
  </defs>
  <rect width="40" height="40" rx="11" fill="url(#logo-g)" />
  <path d="M11 27 L20 12 L29 25" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.95"></path>
  <path d="M11 27 L29 25" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.45"></path>
  <circle cx="11" cy="27" r="3.6" fill="white"></circle>
  <circle cx="20" cy="12" r="3.6" fill="white"></circle>
  <circle cx="29" cy="25" r="3.6" fill="white"></circle>
</svg>
