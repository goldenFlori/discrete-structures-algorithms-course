---
/**
 * One code cell plus its saved outputs.
 *
 * Long implementations collapse behind a summary so the teaching text stays
 * readable; the full source is always one click away and always in the DOM
 * (so browser find and printing still reach it).
 */
import Output from './Output.astro';

interface Props {
  cell: any;
  spoilerWarning?: string;
}
const { cell, spoilerWarning } = Astro.props;
const base = import.meta.env.BASE_URL;

const f = cell.flags;
const needsDesktop = f.pygame || f.tkinter;
const tags: { label: string; cls: string; title: string }[] = [];
if (f.pygame) tags.push({ label: 'Pygame', cls: 'badge-warn', title: 'Hap një dritare desktop — ekzekutohet vetëm lokalisht' });
if (f.tkinter) tags.push({ label: 'Tkinter', cls: 'badge-warn', title: 'Hap një dritare desktop — ekzekutohet vetëm lokalisht' });
if (f.widgets) tags.push({ label: 'ipywidgets', cls: 'badge-neutral', title: 'Kërkon një kernel Jupyter aktiv' });
if (f.plotly && !needsDesktop) tags.push({ label: 'Plotly', cls: 'badge-accent', title: 'Grafik interaktiv — funksionon edhe në këtë faqe' });
if (f.networkx) tags.push({ label: 'NetworkX', cls: 'badge-neutral', title: 'Ndërtim dhe vizatim grafesh' });
if (f.matplotlib && !f.networkx) tags.push({ label: 'matplotlib', cls: 'badge-neutral', title: 'Figura statike' });

const hasSpoiler = Boolean(spoilerWarning) && cell.outputs.some((o: any) => o.kind === 'plotly' || o.kind === 'image');
const id = `code-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="nb-code-cell">
  {(tags.length > 0 || needsDesktop) && (
    <div class="nb-cell-tags">
      {tags.map((t) => <span class={`badge ${t.cls}`} title={t.title}>{t.label}</span>)}
      {needsDesktop && (
        <a class="badge badge-neutral run-local" href={`${base}python/#dritaret-desktop`}>
          Ekzekutohet lokalisht
        </a>
      )}
    </div>
  )}

  {cell.externalScripts?.length > 0 && (
    <div class="callout callout-warn">
      <p class="callout-title">Kërkon skedar shoqërues</p>
      <p>
        Kjo qelizë nis skriptin {cell.externalScripts.map((s: string, i: number) => (
          <>{i > 0 && ', '}<code>{s}</code></>
        ))}, i cili nuk është pjesë e materialeve të publikuara. Pa të, qeliza nuk do të hapë dritaren.
      </p>
      <p style="margin-bottom:0">
        Ekuivalenti web i kësaj demonstrate ndodhet te <a href={`${base}vizualizime/`}>Vizualizime</a>.
      </p>
    </div>
  )}

  <figure class={`nb-code ${cell.collapsed ? 'is-collapsible' : ''}`}>
    {cell.collapsed ? (
      <details class="nb-details">
        <summary>
          <span class="nb-sum-main">
            <span class="nb-sum-label">Implementimi i plotë</span>
            <span class="nb-sum-lines">{cell.lines} rreshta</span>
          </span>
          {cell.summary.length > 0 && (
            <span class="nb-sum-defs">
              {cell.summary.map((d: any) => (
                <code class={d.t === 'class' ? 'is-class' : ''}>{d.n}</code>
              ))}
            </span>
          )}
        </summary>
        <div class="nb-code-inner">
          <button class="nb-copy" type="button" data-copy={id}>Kopjo</button>
          <div class="nb-shiki" id={id} set:html={cell.html} />
        </div>
      </details>
    ) : (
      <div class="nb-code-inner">
        <button class="nb-copy" type="button" data-copy={id}>Kopjo</button>
        <div class="nb-shiki" id={id} set:html={cell.html} />
      </div>
    )}
  </figure>

  {cell.outputs.length > 0 && (
    <div class="nb-outputs">
      {hasSpoiler ? (
        <details class="nb-spoiler">
          <summary>
            <strong>Rezultati i pritshëm</strong>
            <span>{spoilerWarning}</span>
          </summary>
          <div class="nb-spoiler-body">
            {cell.outputs.map((o: any) => <Output out={o} />)}
          </div>
        </details>
      ) : (
        cell.outputs.map((o: any) => <Output out={o} />)
      )}
    </div>
  )}
</div>

<style>
  .nb-code-cell { margin: 1.6em 0; }

  .nb-cell-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .5rem; }
  .run-local { text-decoration: none; }
  .run-local:hover { border-color: var(--accent-line); color: var(--accent-ink); }

  .nb-code { margin: 0; border: 1px solid var(--code-border); border-radius: var(--radius-sm); background: var(--code-bg); overflow: hidden; }
  .nb-code-inner { position: relative; }

  .nb-details > summary {
    cursor: pointer; list-style: none; padding: .6em .85em;
    display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem;
    background: var(--surface-2); border-bottom: 1px solid transparent;
    font-size: .85rem;
  }
  .nb-details > summary::-webkit-details-marker { display: none; }
  .nb-details[open] > summary { border-bottom-color: var(--code-border); }
  .nb-details > summary:hover { background: var(--surface); }
  .nb-sum-main { display: inline-flex; align-items: center; gap: .5rem; }
  .nb-sum-label { font-weight: 600; color: var(--ink-2); }
  .nb-sum-label::before { content: '▸ '; color: var(--ink-faint); }
  .nb-details[open] .nb-sum-label::before { content: '▾ '; }
  .nb-sum-lines { color: var(--ink-faint); font-family: var(--font-mono); font-size: .78rem; }
  .nb-sum-defs { display: flex; flex-wrap: wrap; gap: .3rem; }
  .nb-sum-defs code { font-size: .74rem; padding: .1em .4em; background: var(--surface); color: var(--ink-3); }
  .nb-sum-defs code.is-class { color: var(--violet); border-color: var(--violet-line); }

  .nb-copy {
    position: absolute; top: .45rem; right: .45rem; z-index: 2;
    font: inherit; font-size: .74rem; padding: .25em .6em;
    border: 1px solid var(--border); border-radius: 5px;
    background: var(--surface); color: var(--ink-3); cursor: pointer;
    opacity: 0; transition: opacity .12s;
  }
  .nb-code-inner:hover .nb-copy, .nb-copy:focus-visible { opacity: 1; }
  .nb-copy:hover { color: var(--ink); border-color: var(--border-strong); }
  .nb-copy[data-done] { color: var(--ok); border-color: var(--ok-line); }

  .nb-outputs { margin-top: .5rem; display: flex; flex-direction: column; gap: .5rem; }

  .nb-spoiler { border: 1px dashed var(--warn-line); border-radius: var(--radius-sm); background: var(--warn-soft); }
  .nb-spoiler > summary { cursor: pointer; padding: .7em .9em; font-size: .88rem; display: flex; flex-direction: column; gap: .2em; }
  .nb-spoiler > summary strong { color: var(--warn); }
  .nb-spoiler > summary span { color: var(--ink-3); font-size: .84rem; }
  .nb-spoiler-body { padding: 0 .6em .6em; }
</style>

<style is:global>
  .nb-shiki pre {
    margin: 0; padding: .9em 1em; overflow-x: auto;
    font-family: var(--font-mono); font-size: .845rem; line-height: 1.6;
    -webkit-overflow-scrolling: touch;
    tab-size: 4;
  }
  .nb-shiki pre code { display: block; min-width: max-content; }

  /* Shiki dual-theme switching */
  .nb-shiki pre, .nb-shiki pre span { color: var(--shiki-light); background: transparent; }
  .nb-shiki pre { background-color: var(--shiki-light-bg) !important; }
  :root[data-theme='dark'] .nb-shiki pre,
  :root[data-theme='dark'] .nb-shiki pre span { color: var(--shiki-dark); }
  :root[data-theme='dark'] .nb-shiki pre { background-color: var(--shiki-dark-bg) !important; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .nb-shiki pre,
    :root:not([data-theme='light']) .nb-shiki pre span { color: var(--shiki-dark); }
    :root:not([data-theme='light']) .nb-shiki pre { background-color: var(--shiki-dark-bg) !important; }
  }

  /* ---- outputs ---- */
  .nb-out {
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--surface); overflow: hidden;
  }
  .nb-out-head {
    font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-faint); padding: .45em .8em; border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .nb-out pre {
    margin: 0; padding: .75em .9em; overflow-x: auto;
    font-family: var(--font-mono); font-size: .8rem; line-height: 1.55;
    color: var(--ink-2); white-space: pre; background: var(--surface);
  }
  .nb-out-img { display: block; padding: .5em; background: var(--surface); }
  .nb-out-img img { display: block; margin: 0 auto; border-radius: 4px; }
  .nb-out-note {
    display: flex; gap: .6em; padding: .7em .9em; font-size: .86rem; align-items: flex-start;
  }
  .nb-out-note .n-ico { flex: none; margin-top: .1em; }
  .nb-out-note strong { display: block; font-size: .82rem; }
  .nb-out-note p { margin: .15em 0 0; color: var(--ink-3); font-size: .84rem; }
  .nb-out-benign { background: var(--surface-2); border-style: dashed; color: var(--ink-3); }
  .nb-out-error { background: var(--danger-soft); border-color: var(--danger-line); }
  .nb-out-error .nb-out-head { color: var(--danger); background: transparent; border-color: var(--danger-line); }
  .nb-out-error pre { background: transparent; color: var(--ink-2); font-size: .76rem; }
</style>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('.nb-copy') as HTMLButtonElement | null;
    if (!btn) return;
    const pre = document.getElementById(btn.dataset.copy!)?.querySelector('pre');
    if (!pre) return;
    try {
      await navigator.clipboard.writeText(pre.textContent || '');
      btn.textContent = 'U kopjua';
      btn.dataset.done = '1';
      setTimeout(() => { btn.textContent = 'Kopjo'; delete btn.dataset.done; }, 1600);
    } catch {
      btn.textContent = 'Gabim';
      setTimeout(() => { btn.textContent = 'Kopjo'; }, 1600);
    }
  });
</script>
